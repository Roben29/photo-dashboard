# Supabase PostgreSQL Database Connection
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials

# Transaction Pooler (Port 6543) - used by Prisma Client for app runtime
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgboiler=true&connection_limit=1"

# Direct Connection (Port 5432) - used by Prisma CLI for migrations / db push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
